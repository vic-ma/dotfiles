[user]
    name            = Victor Ma
    email           = victor@victorma.ca
[alias]
    ad              = add
    ada             = add --all
    bb              = bisect bad
    bg              = bisect good
    bl              = blame -s
    br              = branch
    bra             = branch --all
    brac            = branch -a --contains
    brc             = branch --contains
    brd             = branch -D
    brm             = branch --move
    brs             = bisect reset
    bst             = bisect start
    bsk             = bisect skip
    blg             = bisect log
    cl              = clean
    clf             = clean -f
    clfd            = clean -fd
    co              = checkout
    cob             = checkout -b
    coh             = co HEAD
    coh1            = co HEAD~1
    coh2            = co HEAD~2
    coh3            = co HEAD~3
    coh4            = co HEAD~4
    coh5            = co HEAD~5
    com             = co master
    cop             = checkout -
    ct              = commit
    cta             = commit -a
    ctam            = commit --amend
    ctama           = commit -a --amend
    ctm             = commit -m
    df              = diff
    dfc             = diff --check
    dfcm            = diff --check master
    dfh             = diff HEAD
    dfh1            = diff HEAD~1
    dfh2            = diff HEAD~2
    dfh3            = diff HEAD~3
    dfh4            = diff HEAD~4
    dfh5            = diff HEAD~5
    dfho            = diff HEAD @{u}
    dfm             = diff master
    dfmm            = diff master...
    dfo             = diff @{u}
    dfs             = diff --cached
    fp              = fetch --prune
    ft              = fetch
    fta             = fetch --all
    lg              = log --oneline
    lga             = log --oneline --all
    lgr             = log --graph --oneline
    lgra            = log --graph --all --oneline
    loga            = log --all
    ma              = master
    mg              = merge --no-ff
    pl              = pull
    plu             = pull upstream master
    ps              = push
    psf             = push --force
    psa             = push --all
    rb              = rebase
    rba             = rebase --abort
    rbc             = rebase --continue
    rbi             = rebase -i
    rbim            = rebase -i master
    rbm             = rebase master
    rs              = reset
    rsh             = reset --hard
    rt              = remote
    rta             = remote add
    rtv             = remote -v
    s               = show
    sc              = stash clear
    sh              = show HEAD
    sh1             = show HEAD~1
    sh2             = show HEAD~2
    sh3             = show HEAD~3
    sh4             = show HEAD~4
    sh5             = show HEAD~5
    sl              = stash list
    soh             = show @{u}
    sp              = stash pop
    st              = status
[fetch]
    prune           = true
[advice]
    detachedHead    = false
[push]
    autoSetupRemote = true
[pager]
    branch          = false
[core]
    editor          = vim
    excludesfile    = /home/victor/.gitignore
