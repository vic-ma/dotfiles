alias p='cd ..'
alias l='ls'
alias sd='shutdown now'
alias rs='reset'
alias rb='sudo reboot'
alias vg='vi ~/.gitconfig'
alias vb='vi ~/.bashrc && sb'
alias sb='source ~/.bashrc'
alias sz='sudo zypper'
alias zi='sz in'
alias zr='sz refresh'
alias zup='sz dup'
alias de='env XDG_DATA_DIRS= distrobox enter primary'
alias check='command zypper > /dev/null 2>&1'
alias ceditor='crossword-editor'
alias cc='crosswords'
alias cs='cd ~/crosswords/src'
alias cw='cd ~/crosswords'
alias cu='cd ~/crosswords-upstream'
alias bb='check && rs && sh ~/scripts/b'
alias dd='check && rs && sh ~/scripts/d'
alias ddg='check && rs && sh ~/scripts/dg'
alias bu='git ada && git ctm Backup && git ps'
alias aqr='rs && aq'
alias raq='aqr'
alias ziy='zi -y'
alias diff='colordiff -u'
alias wlc='wl-copy'
alias wlp='wl-paste'
alias va='vi ~/.bash_aliases && sb'
alias ud='sudo apt update'
alias ug='sudo apt upgrade -y'
alias udg='ud && ug'
alias ugr='ud && sudo apt upgrade -y && rb'
alias ag='ag -U 2> /dev/null'
alias be='bb && ce'
alias bw='bb && cc'
alias tt='check && rs && sh ~/scripts/t'
alias ct='rmb && tt'
alias ra='ar'
alias vl='vi /home/victor/crosswords/_build/meson-logs/testlog.txt'
alias tl='tt; vl'
alias f='rs && ag'
alias li='cd ~/crosswords/subprojects/libipuz'
alias vv='vi ~/.vimrc'
alias vgi='vi ~/.gitignore'
alias cb='check && rmb && bb'
alias cbe='check && rmb && be'
alias ccb='check && rmbs && bb'
alias ccbe='check && rmbs && be'
alias rmb='sudo rm -rf _build _libipuz_build 2> /dev/null'
alias rmbs='rmb && sudo rm -rf subprojects/libipuz 2> /dev/null'
alias cpi='rmbs && cp -R ~/libipuz-upstream subprojects/libipuz && li'
alias dins='sudo zypper install -y vim fzf ripgrep wl-clipboard'
alias pi='pip install --break-system-packages'
alias lu='cd ~/libipuz-upstream'
alias cu='cd ~/crosswords-upstream'
alias fe='flatpak run org.gnome.Crosswords.Editor'
alias pullimage='bash ~/crosswords/ci/pull-container-image.sh'
alias ins='sudo apt install -y'
alias ar='sudo apt autoremove -y'
alias cwd='cd ~/crosswords/docs'
alias cen='ceditor ~/puzzles/nyt.ipuz'
alias ben='bb && cen'
alias cet='ceditor ~/puzzles/testing.ipuz'
alias bet='bb && cet'
alias ced='ceditor ~/puzzles/default.ipuz'
alias bed='bb && ced'
alias denter='env XDG_DATA_DIRS= distrobox enter'
alias dtesting='denter testing'
alias ce='ceditor ~/puzzles/blank.ipuz'
alias det='denter testing'
alias cm='cd ~/crosswords-mirror'
alias gut='git'
alias find='fdfind'
