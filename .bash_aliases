alias p='cd ..'
alias l='ls'
alias sd='shutdown now'
alias rs='reset'
alias rb='sudo reboot'
alias vg='vi ~/.gitconfig'
alias vb='vi ~/.bashrc && sb'
alias sb='source ~/.bashrc'
alias sz='sudo zypper'
alias zi='sz in'
alias zr='sz refresh'
alias zup='sz dup'
alias de='env XDG_DATA_DIRS= distrobox enter primary'
alias check='command zypper > /dev/null 2>&1'
alias cc='crosswords'
alias cs='cd ~/crosswords/src'
alias cwt='cd ~/crosswords/src/tests/clue-matches'
alias cw='cd ~/crosswords'
alias cu='cd ~/crosswords-upstream'
alias cus='cd ~/crosswords-upstream/src'
alias bb='check && rs && sh ~/scripts/b'
alias dd='check && rs && sh ~/scripts/d'
alias ddg='check && rs && sh ~/scripts/dg'
alias bu='git ada && git ctm Backup && git ps'
alias bue='git ada && git ct --allow-empty -m Backup && git ps'
alias aqr='rs && aq'
alias raq='aqr'
alias ziy='zi -y'
alias diff='colordiff -u'
alias wlc='wl-copy'
alias wlp='wl-paste'
alias va='vi ~/.bash_aliases && sb'
alias ud='sudo apt update'
alias ug='sudo apt upgrade -y'
alias udg='ud && ug'
alias ugr='ud && sudo apt upgrade -y && rb'
alias ag='rs && ag'
alias f='ag 2> /dev/null'
alias fa='ag -a'
alias fl='ag -l'
alias be='bb && ce'
alias bw='bb && cc'
alias tt='check && rs && sh ~/scripts/t'
alias ce='crossword-editor'
alias ct='rmb && tt'
alias ra='ar'
alias vl='vi _build/meson-logs/testlog.txt'
alias tl='tt; vl'
alias li='cd ~/libipuz'
alias lib='cd ~/libipuz/libipuz'
alias ld='cd ~/libipuz/docs'
alias vv='vi ~/.vimrc'
alias vgi='vi ~/.gitignore'
alias cb='check && rmb && bb'
alias cbe='check && rmb && be'
alias cbed='check && rmb && bed'
alias cbet='check && rmb && bet'
alias ccb='check && rmbs && bb'
alias ccbe='check && rmbs && be'
alias ct='check && rmb && tt'
alias cct='check && rmbs && tt'
alias rmb='sudo rm -rf _build _libipuz_build 2> /dev/null'
alias rmbs='rmb && sudo rm -rf subprojects/libipuz 2> /dev/null'
alias cpli='rmbs && sudo rm -rf ~/libipuz/_build && cp -R ~/libipuz subprojects/libipuz'
alias sl='cd ~/crosswords/subprojects/libipuz'
alias now='cpli && tt'
alias dins='sudo zypper install -y vim fzf ripgrep wl-clipboard'
alias pi='pip install --break-system-packages'
alias lu='cd ~/libipuz-upstream'
alias cu='cd ~/crosswords-upstream'
alias fe='flatpak run org.gnome.Crosswords.Editor'
alias pullimage='bash ~/crosswords/ci/pull-container-image.sh'
alias ins='sudo apt install -y'
alias ar='sudo apt autoremove -y'
alias cwd='cd ~/crosswords/docs'
alias cen='ce ~/puzzles/nyt.ipuz'
alias ben='bb && cen'
alias cet='ce ~/puzzles/test.ipuz'
alias cet2='ce ~/puzzles/test2.ipuz'
alias cet3='ce ~/puzzles/test3.ipuz'
alias bet='bb && cet'
alias bet2='bb && cet2'
alias bet3='bb && cet3'
alias ced='ce ~/puzzles/default.ipuz'
alias bed='bb && ced'
alias denter='env XDG_DATA_DIRS= distrobox enter'
alias dtesting='denter testing'
alias dclone='denter primary-clone'
alias ceb='ce ~/puzzles/blank.ipuz'
alias det='denter testing'
alias cm='cd ~/crosswords-mirror'
alias gut='git'
alias fdfind='fdfind -I'
alias fd='fdfind'
alias find='fd'
alias ces='ce ~/puzzles/small_blank.ipuz'
alias bes='bb && ces'
alias vig='vi ~/.ignore'
alias lt='rs && source ci/env.sh && sudo --preserve-env=PATH,RUSTUP_HOME sh ci/build-with-coverage.sh'
alias rg='rg --no-ignore'
